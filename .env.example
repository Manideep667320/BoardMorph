# ==============================================================================
# BoardMorph Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Qwen via OpenRouter (Recommended)
# ------------------------------------------------------------------------------
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter OpenAI-compatible endpoint
QWEN_BASE_URL=https://openrouter.ai/api/v1

# Popular Qwen models on OpenRouter:
# - qwen/qwen-2.5-72b-instruct       (Flagship reasoning & graph compilation - Recommended)
# - qwen/qwen-2.5-coder-32b-instruct (Optimized for structured code & JSON schemas)
# - qwen/qwen-2.5-7b-instruct        (Fast, ultra low-cost for rapid testing)
# - qwen/qwq-32b-preview             (Deep reasoning / Chain-of-thought)
QWEN_MODEL=qwen/qwen-2.5-72b-instruct

# (Optional) Direct Alibaba Cloud DashScope alternative:
# QWEN_API_KEY=your_dashscope_api_key_here
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus

# Offline fallback: if set to True, the app falls back to a deterministic compiler
# when the LLM API is unavailable or unconfigured.
USE_MOCK_LLM_FALLBACK=True


# ------------------------------------------------------------------------------
# 2. Miro App Configuration (Direct REST API)
# ------------------------------------------------------------------------------
# Generate your Miro App Access Token from your Miro App at: https://developers.miro.com/
# In your Miro App settings -> "Install app and get OAuth token" -> copy the Access Token.
# Required scopes: boards:read (and boards:write for Break My Agent canvas write-back)
MIRO_ACCESS_TOKEN=your_miro_access_token_here
MIRO_CLIENT_ID=your_client_id_here
MIRO_CLIENT_SECRET=your_client_secret_here

# Miro Board ID from your Miro URL: https://miro.com/app/board/<board_id>/
MIRO_BOARD_ID=your_board_id_here

MIRO_API_BASE_URL=https://api.miro.com/v2


# ------------------------------------------------------------------------------
# 3. Application Settings
# ------------------------------------------------------------------------------
APP_NAME=BoardMorph
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "*"]
